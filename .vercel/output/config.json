{
  "version": 3,
  "routes": [
    {
      "src": "^/api/webhook$",
      "dest": "/api/webhook"
    },
    {
      "src": "^/api/cron$",
      "dest": "/api/cron"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:ts))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "framework": {
    "slug": "tanstack-start",
    "version": "1.168.18"
  },
  "crons": []
}
