{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "functions": {
    "api/webhook.ts": { "maxDuration": 60 },
    "api/cron.ts": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook" },
    { "src": "/api/cron", "dest": "/api/cron" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
